{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/portal.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "*.xml",
      "use": "@vercel/static"
    },
    {
      "src": "*.txt",
      "use": "@vercel/static"
    },
    {
      "src": "*.pdf",
      "use": "@vercel/static"
    },
    {
      "src": "*.mp4",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/api/portal/(.*)$",
      "dest": "/api/portal.js?route=$1"
    },
    {
      "src": "^/api/portal$",
      "dest": "/api/portal.js"
    },
    {
      "src": "^/$",
      "dest": "/customer-portal.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
